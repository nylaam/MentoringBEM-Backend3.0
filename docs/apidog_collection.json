{
  "info": {
    "_postman_id": "7d9e4a3b-9e8c-4a11-8862-df982a51f0ab",
    "name": "Toko Backend API - Product Service (Mentoring & Workshop)",
    "description": "Koleksi API siap pakai untuk pengujian di Postman atau Apidog. Port default 6767 dengan proteksi API Key.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:6767",
      "type": "string"
    },
    {
      "key": "apiKey",
      "value": "mentoring-secret-api-key-2026",
      "type": "string"
    },
    {
      "key": "productId",
      "value": "prod-001",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. System",
      "item": [
        {
          "name": "Root Welcome API",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/",
              "host": ["{{baseUrl}}"],
              "path": [""]
            },
            "description": "Memeriksa status root server."
          }
        },
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/healthz",
              "host": ["{{baseUrl}}"],
              "path": ["healthz"]
            },
            "description": "Memeriksa apakah server Fiber v3 dan database berjalan."
          }
        }
      ]
    },
    {
      "name": "2. Products (Protected with API Key)",
      "item": [
        {
          "name": "Ambil Semua Produk (GET)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{apiKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/products",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "products"]
            },
            "description": "Mengambil seluruh daftar produk dari database atau in-memory."
          }
        },
        {
          "name": "Ambil Produk by ID (GET)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{apiKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/products/{{productId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "products", "{{productId}}"]
            },
            "description": "Mengambil detail satu produk berdasarkan ID."
          }
        },
        {
          "name": "Tambah Produk Baru (POST)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-API-Key",
                "value": "{{apiKey}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Wireless Mouse Ergonomis\",\n  \"price\": 650000,\n  \"stock\": 100\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/products",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "products"]
            },
            "description": "Menambahkan produk baru ke katalog toko."
          }
        },
        {
          "name": "Update Produk Penuh (PUT)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-API-Key",
                "value": "{{apiKey}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Laptop Gaming ASUS ROG Scar 16\",\n  \"price\": 27500000,\n  \"stock\": 8\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/products/{{productId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "products", "{{productId}}"]
            },
            "description": "Memperbarui semua field produk (PUT)."
          }
        },
        {
          "name": "Update Parsial Produk - Stok Saja (PATCH)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-API-Key",
                "value": "{{apiKey}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"stock\": 99\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/products/{{productId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "products", "{{productId}}"]
            },
            "description": "Memperbarui sebagian field produk, misalnya update stok atau harga (PATCH)."
          }
        },
        {
          "name": "Update Parsial Produk - Harga Saja (PATCH)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-API-Key",
                "value": "{{apiKey}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"price\": 24000000\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/products/{{productId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "products", "{{productId}}"]
            },
            "description": "Memperbarui harga produk saja (PATCH)."
          }
        },
        {
          "name": "Hapus Produk (DELETE)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{apiKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/products/{{productId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "products", "{{productId}}"]
            },
            "description": "Menghapus produk berdasarkan ID uniknya."
          }
        }
      ]
    }
  ]
}
