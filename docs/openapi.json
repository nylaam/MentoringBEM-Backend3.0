{
  "openapi": "3.0.3",
  "info": {
    "title": "Toko Backend API - Product Domain (Mentoring & Workshop)",
    "description": "Spesifikasi REST API untuk Lab Mentoring Backend Go Fiber v3 (Clean Architecture & DDD). Fokus pada domain Product dengan CRUD lengkap dan PATCH untuk update parsial/kecil serta proteksi API Key.",
    "version": "1.0.0",
    "contact": {
      "name": "Mentoring Backend Team"
    }
  },
  "servers": [
    {
      "url": "/",
      "description": "Server Aktif (Otomatis mendeteksi Domain & HTTPS)"
    },
    {
      "url": "http://localhost:6767",
      "description": "Lokal Server Pengembangan (Fiber v3 Port 6767)"
    }
  ],
  "security": [
    {
      "ApiKeyAuth": []
    }
  ],
  "tags": [
    {
      "name": "System",
      "description": "Endpoint pemeriksaan kesehatan aplikasi"
    },
    {
      "name": "Products",
      "description": "Manajemen Produk - CRUD dan PATCH"
    }
  ],
  "paths": {
    "/": {
      "get": {
        "tags": ["System"],
        "summary": "Root Info API",
        "description": "Menampilkan status dan rute utama API.",
        "security": [],
        "responses": {
          "200": {
            "description": "Berhasil mendapatkan info API"
          }
        }
      }
    },
    "/healthz": {
      "get": {
        "tags": ["System"],
        "summary": "Pemeriksaan Kesehatan Server (Health Check)",
        "description": "Memastikan instance Go Fiber v3 berjalan dengan normal.",
        "security": [],
        "responses": {
          "200": {
            "description": "Server dalam kondisi sehat",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthCheckResponse"
                },
                "example": {
                  "success": true,
                  "data": {
                    "status": "healthy",
                    "database": "connected",
                    "time": "2026-11-15T10:00:00Z",
                    "version": "1.0.0"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/products": {
      "get": {
        "tags": ["Products"],
        "summary": "Ambil Seluruh Daftar Produk",
        "description": "Mengambil list semua produk yang tersedia di katalog toko.",
        "responses": {
          "200": {
            "description": "Daftar produk berhasil diambil",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductListResponse"
                },
                "example": {
                  "success": true,
                  "data": [
                    {
                      "id": "prod-001",
                      "name": "Laptop Gaming ASUS ROG",
                      "price": 25000000,
                      "stock": 10,
                      "created_at": "2026-11-15T06:00:00Z",
                      "updated_at": "2026-11-15T06:00:00Z"
                    },
                    {
                      "id": "prod-002",
                      "name": "Mechanical Keyboard",
                      "price": 1200000,
                      "stock": 50,
                      "created_at": "2026-11-15T06:00:00Z",
                      "updated_at": "2026-11-15T06:00:00Z"
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          }
        }
      },
      "post": {
        "tags": ["Products"],
        "summary": "Tambah Produk Baru",
        "description": "Menambahkan data produk baru ke katalog toko.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateProductRequest"
              },
              "example": {
                "name": "Monitor UltraSharp 27 Inch 4K",
                "price": 9500000,
                "stock": 20
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Produk berhasil ditambahkan",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductSingleResponse"
                },
                "example": {
                  "success": true,
                  "data": {
                    "id": "6732f7a9-d3e1-45f8-8092-d6fc7b95e341",
                    "name": "Monitor UltraSharp 27 Inch 4K",
                    "price": 9500000,
                    "stock": 20,
                    "created_at": "2026-11-15T06:00:00Z",
                    "updated_at": "2026-11-15T06:00:00Z"
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequestError"
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          }
        }
      }
    },
    "/api/v1/products/{id}": {
      "get": {
        "tags": ["Products"],
        "summary": "Ambil Detail Produk by ID",
        "description": "Mengambil satu objek data produk spesifik berdasarkan ID.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "ID unik produk",
            "schema": {
              "type": "string"
            },
            "example": "prod-001"
          }
        ],
        "responses": {
          "200": {
            "description": "Data produk ditemukan",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductSingleResponse"
                },
                "example": {
                  "success": true,
                  "data": {
                    "id": "prod-001",
                    "name": "Laptop Gaming ASUS ROG",
                    "price": 25000000,
                    "stock": 10,
                    "created_at": "2026-11-15T06:00:00Z",
                    "updated_at": "2026-11-15T06:00:00Z"
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          },
          "404": {
            "$ref": "#/components/responses/NotFoundError"
          }
        }
      },
      "put": {
        "tags": ["Products"],
        "summary": "Update Penuh Produk by ID (PUT)",
        "description": "Memperbarui seluruh field data produk (name, price, stock).",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "ID unik produk yang akan diupdate",
            "schema": {
              "type": "string"
            },
            "example": "prod-001"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateProductRequest"
              },
              "example": {
                "name": "Laptop Gaming ASUS ROG Scar 16",
                "price": 27500000,
                "stock": 8
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Produk berhasil diperbarui",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductSingleResponse"
                },
                "example": {
                  "success": true,
                  "data": {
                    "id": "prod-001",
                    "name": "Laptop Gaming ASUS ROG Scar 16",
                    "price": 27500000,
                    "stock": 8,
                    "created_at": "2026-11-15T06:00:00Z",
                    "updated_at": "2026-11-15T07:15:00Z"
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequestError"
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          },
          "404": {
            "$ref": "#/components/responses/NotFoundError"
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          }
        }
      },
      "patch": {
        "tags": ["Products"],
        "summary": "Update Parsial Produk by ID (PATCH)",
        "description": "Memperbarui bagian kecil produk seperti hanya stok, hanya harga, atau hanya nama. Minimal satu field harus disediakan.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "ID unik produk yang akan dipatch",
            "schema": {
              "type": "string"
            },
            "example": "prod-001"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PatchProductRequest"
              },
              "example": {
                "stock": 99
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Produk berhasil diperbarui sebagian",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductSingleResponse"
                },
                "example": {
                  "success": true,
                  "data": {
                    "id": "prod-001",
                    "name": "Laptop Gaming ASUS ROG",
                    "price": 25000000,
                    "stock": 99,
                    "created_at": "2026-11-15T06:00:00Z",
                    "updated_at": "2026-11-15T08:00:00Z"
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequestError"
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          },
          "404": {
            "$ref": "#/components/responses/NotFoundError"
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          }
        }
      },
      "delete": {
        "tags": ["Products"],
        "summary": "Hapus Produk by ID",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "ID unik produk yang akan dihapus",
            "schema": {
              "type": "string"
            },
            "example": "prod-001"
          }
        ],
        "responses": {
          "200": {
            "description": "Produk berhasil dihapus",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MessageResponse"
                },
                "example": {
                  "success": true,
                  "data": {
                    "message": "Produk berhasil dihapus"
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          },
          "404": {
            "$ref": "#/components/responses/NotFoundError"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key",
        "description": "Kunci API untuk mengakses endpoint /api/v1 (contoh: mentoring-secret-api-key-2026)"
      }
    },
    "schemas": {
      "CreateProductRequest": {
        "type": "object",
        "required": ["name", "price", "stock"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 3,
            "maxLength": 100,
            "description": "Nama produk (3 - 100 karakter)",
            "example": "Mechanical Keyboard"
          },
          "price": {
            "type": "integer",
            "format": "int64",
            "minimum": 1,
            "description": "Harga produk (harus > 0)",
            "example": 1200000
          },
          "stock": {
            "type": "integer",
            "minimum": 0,
            "description": "Jumlah stok produk (harus >= 0)",
            "example": 50
          }
        }
      },
      "UpdateProductRequest": {
        "type": "object",
        "required": ["name", "price", "stock"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 3,
            "maxLength": 100,
            "description": "Nama produk baru",
            "example": "Mechanical Keyboard RGB"
          },
          "price": {
            "type": "integer",
            "format": "int64",
            "minimum": 1,
            "description": "Harga produk baru (harus > 0)",
            "example": 1450000
          },
          "stock": {
            "type": "integer",
            "minimum": 0,
            "description": "Stok baru (harus >= 0)",
            "example": 45
          }
        }
      },
      "PatchProductRequest": {
        "type": "object",
        "description": "Update parsial produk. Minimal satu field disediakan.",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 3,
            "maxLength": 100,
            "description": "Nama produk (opsional)",
            "example": "Mechanical Keyboard Wireless"
          },
          "price": {
            "type": "integer",
            "format": "int64",
            "minimum": 1,
            "description": "Harga produk (opsional)",
            "example": 1350000
          },
          "stock": {
            "type": "integer",
            "minimum": 0,
            "description": "Stok produk (opsional)",
            "example": 60
          }
        }
      },
      "ProductItem": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "prod-001"
          },
          "name": {
            "type": "string",
            "example": "Laptop Gaming ASUS ROG"
          },
          "price": {
            "type": "integer",
            "format": "int64",
            "example": 25000000
          },
          "stock": {
            "type": "integer",
            "example": 10
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ProductSingleResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": true
          },
          "data": {
            "$ref": "#/components/schemas/ProductItem"
          }
        }
      },
      "ProductListResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": true
          },
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProductItem"
            }
          }
        }
      },
      "HealthCheckResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": true
          },
          "data": {
            "type": "object",
            "properties": {
              "status": {
                "type": "string",
                "example": "healthy"
              },
              "database": {
                "type": "string",
                "example": "connected"
              },
              "time": {
                "type": "string",
                "format": "date-time"
              },
              "version": {
                "type": "string",
                "example": "1.0.0"
              }
            }
          }
        }
      },
      "MessageResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": true
          },
          "data": {
            "type": "object",
            "properties": {
              "message": {
                "type": "string",
                "example": "Produk berhasil dihapus"
              }
            }
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": false
          },
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "example": "PRODUCT_NOT_FOUND"
              },
              "message": {
                "type": "string",
                "example": "produk tidak ditemukan"
              },
              "request_id": {
                "type": "string",
                "example": "9a38f38d-8a58-450f-a720-3ce4802c1db8"
              }
            }
          }
        }
      }
    },
    "responses": {
      "UnauthorizedError": {
        "description": "Unauthorized - API Key tidak valid atau belum disertakan",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "example": {
              "success": false,
              "error": {
                "code": "UNAUTHORIZED",
                "message": "API Key tidak valid atau belum disertakan di header 'X-API-Key'",
                "request_id": "9b12c8a1-7b02-472e-9d21-419bcf0184fa"
              }
            }
          }
        }
      },
      "BadRequestError": {
        "description": "Bad Request - Format request tidak valid",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "example": {
              "success": false,
              "error": {
                "code": "Bad Request",
                "message": "Format JSON tidak valid",
                "request_id": "42616aef-b0a7-47b2-bd77-a8b27341ad6c"
              }
            }
          }
        }
      },
      "NotFoundError": {
        "description": "Not Found - Resource tidak ditemukan",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "example": {
              "success": false,
              "error": {
                "code": "PRODUCT_NOT_FOUND",
                "message": "produk tidak ditemukan",
                "request_id": "89e5a1b3-5683-4217-a02d-02195f22384a"
              }
            }
          }
        }
      },
      "ValidationError": {
        "description": "Unprocessable Entity - Validasi gagal",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "example": {
              "success": false,
              "error": {
                "code": "INVALID_NAME",
                "message": "nama produk minimal harus 3 karakter",
                "request_id": "c1a6b043-4cb2-475a-a387-99cf1600f1ce"
              }
            }
          }
        }
      }
    }
  }
}
