# Server Port (Default: 6767. Di Cloud seperti Railway/Render, PORT akan otomatis terdeteksi)
APP_PORT=6767
APP_ENV=development

# API Key Authentication (Kirim via header 'X-API-Key' atau 'Authorization: Bearer <key>')
API_KEY=mentoring-secret-api-key-2026

# Swagger UI Basic Auth (Username & Password untuk membuka /docs di browser)
SWAGGER_USER=admin
SWAGGER_PASSWORD=admin123

# PostgreSQL Container Variables (Sinkron dengan DATABASE_USER/PASSWORD/NAME untuk Docker)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=toko_db
